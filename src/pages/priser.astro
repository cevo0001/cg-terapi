---
import Layout from '../layouts/Layout.astro';

import PriceHero from '../components/PriceHero.astro';
import PriceCards from '../components/PriceCards.astro';
import TreatmentWork from '../components/TreatmentWork.astro';
import PriceInfo from '../components/PriceInfo.astro';

import IndexCta from '../components/IndexCta.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout>
  <PriceHero />
  <PriceCards />
  <TreatmentWork
    itemOne="Nærvær & Tid"
    itemTwo="Helhedlig tilgang"
    itemThree="Trygt rum"
    itemFour="Støtte til din rejse"
    itemFive=""
    itemSix=""

    textOne="Du får min fulde opmærksomhed og tid."
    textTwo="Jeg ser dig som et helt menneske - krop, sind og energi."
    textThree="Et fortroligt og kærligt rum, hvor du kan være dig selv."
    textFour="Redskaber og indsigter, der støtter dig i din udvikling."
    textFive=""
    textSix=""
  />
  <PriceInfo />
  <IndexCta />
  <Testimonials />
</Layout>