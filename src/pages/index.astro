---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Forside">

  <section class="hero">

    <div class="hero-text">
      <h1>
        Et trygt rum <br />
        til kvinder i <br />
        overgang og udvikling
      </h1>

      <p>
        Holistisk terapi der skaber balance i krop,
        sind og nervesystem.
      </p>

      <div class="hero-buttons">
        <a href="/" class="btn">Book tid</a>
        <a href="/" class="btn-outline">Læs mere</a>
      </div>
    </div>

    <div class="hero-image">
      HERO BILLEDE
    </div>

  </section>

</Layout>