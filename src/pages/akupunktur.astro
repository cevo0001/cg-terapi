---
import Layout from '../layouts/Layout.astro';

import TreatmentHero from '../components/TreatmentHero.astro';
import TreatmentWork from '../components/TreatmentWork.astro';
import TreatmentProcess from '../components/TreatmentProcess.astro';
import TreatmentInfo from '../components/TreatmentInfo.astro';

import IndexCta from '../components/IndexCta.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout>

<TreatmentHero
  title="Japansk Ansigtsakupunktur"
  subtitle="Naturlig behandling med fokus på balance, energi og velvære"
  text="Her står tekst omkring japansk ansigtsakupunktur."
  image="/images/akupunktur.webp"
/>

<TreatmentWork />

<TreatmentProcess
  title="Sådan foregår det"
  image="/images/akupunktur-room.webp"
/>

<TreatmentInfo
  title="Hvad er japansk ansigtsakupunktur?"
  textOne="Her står første tekst omkring behandlingen."
  textTwo="Her står anden tekst omkring behandlingen."
/>

<IndexCta />

<Testimonials />

</Layout>