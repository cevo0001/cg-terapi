---
import Layout from '../layouts/Layout.astro';

import TreatmentHero from '../components/TreatmentHero.astro';
import TreatmentWork from '../components/TreatmentWork.astro';
import TreatmentProcess from '../components/TreatmentProcess.astro';
import TreatmentInfo from '../components/TreatmentInfo.astro';

import IndexCta from '../components/IndexCta.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout>

<TreatmentHero
  title="Japansk Ansigtsakupunktur"
  subtitle="Naturlig behandling med fokus på balance, energi og velvære"
  text="Her står tekst omkring japansk ansigtsakupunktur."
  image="/images/akupunktur.webp"
/>

<TreatmentWork
  itemOne="Spændinger & Afspænding"
  itemTwo="Glød & Vitalitet"
  itemThree="Ro & Nervesystem"
  itemFour="Ansigt & Balance"
  itemFive="Selvomsorg & Nærvær"
  itemSix="Energi & Fornyelse"

  textOne="Blid støtte til at løsne spændinger i ansigt og kæbe."
  textTwo="Stimulerer hudens naturlige glød og blodcirkulation."
  textThree="Giver kroppen mulighed for at falde mere til ro."
  textFour="Skaber balance mellem ansigtets spændinger og kroppens velvære."
  textFive="Et stille rum med fokus på afslapning og fordybelse."
  textSix="Mange oplever en følelse af lethed og ny energi efter behandlingen."
/>

<TreatmentProcess
  title="Sådan foregår det"
  image="/images/kontakt-strand.webp"

  stepOneTitle="Vi begynder med at lande"
stepOneText="Behandlingen starter med peeling og blid ansigtsmassage, så huden og kroppen forberedes."

stepTwoTitle="Der arbejdes med ansigtets spændinger"
stepTwoText="Fokus er på de områder, hvor der ses linjer, spændinger eller ubalance i ansigtet."

stepThreeTitle="Akupunkturen går i dybden"
stepThreeText="De fine nåle stimulerer huden og støtter blodcirkulation, glød og naturlig vitalitet."

stepFourTitle="Du afslutter med ro i systemet"
stepFourText="Mange oplever en følelse af lethed, afspænding og fornyet energi efter behandlingen."
/>

<TreatmentInfo
  title="Hvad er japansk ansigtsakupunktur?"
  textOne="Japansk ansigtsakupunktur er en blid og dybdegående behandling, der arbejder med både hud, spændinger og kroppens indre balance. 
Behandlingen kombinerer ansigtsmassage, peeling og fine akupunkturnåle, som stimulerer blodcirkulationen og understøtter hudens naturlige glød og spændstighed. Mange oplever behandlingen som både beroligende og opløftende.
"
  textTwo="– et stille rum, hvor kroppen får lov til at slippe spændinger og nervesystemet falder til ro. Japansk ansigtsakupunktur arbejder særligt med: spændinger i ansigt og kæbe, hudens glød og elasticitet, fine linjer og spændingsmønstre, ro og balance i kroppen.
 Behandlingen varer 60 minutter og koster 650 kr."
/>

<IndexCta />



</Layout>