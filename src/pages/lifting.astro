---
import Layout from '../layouts/Layout.astro';

import TreatmentHero from '../components/TreatmentHero.astro';
import TreatmentWork from '../components/TreatmentWork.astro';
import TreatmentProcess from '../components/TreatmentProcess.astro';
import TreatmentInfo from '../components/TreatmentInfo.astro';

import IndexCta from '../components/IndexCta.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout>

<TreatmentHero
  title="Japansk Lifting"
  subtitle="Naturlig ansigtsbehandling med fokus på glød, ro og balance"
  text="Her står tekst omkring japansk lifting og behandlingen."
  image="/images/lifting.webp"
/>

<TreatmentWork
  itemOne="Afspænding & Velvære"
  itemTwo="Glød & Cirkulation"
  itemThree="Ansigt & Løft"
  itemFour="Ro & Nervesystem"
  itemFive="Selvpleje & Balance"
  itemSix="Lethed & Fornyelse"

  textOne="Giv kroppen mulighed for at slippe spændinger."
  textTwo="Stimulerer blodcirkulationen og hudens naturlige udstråling."
  textThree="Blide teknikker arbejder med ansigtets naturlige spændstighed."
  textFour="Et stille åndehul med fokus på afslapning og nærvær."
  textFive="Skab mere kontakt til kroppen gennem ro og sanselighed."
  textSix="Mange oplever en følelse af friskhed, lethed og ny energi."
/>

<TreatmentProcess
  title="Sådan foregår det"
  image="/images/lift2.webp"

  stepOneTitle="Du bliver guidet ind i ro"
stepOneText="Behandlingen starter i et langsomt tempo, hvor kroppen får mulighed for at lande."

stepTwoTitle="Ansigtet vækkes blidt"
stepTwoText="Peeling, massage og zoneterapi stimulerer hud, muskler og cirkulation."

stepThreeTitle="Spændinger løsnes lag for lag"
stepThreeText="De dybe teknikker arbejder med ansigtets naturlige udtryk og hjælper kroppen med at slippe."

stepFourTitle="Du går herfra med glød"
stepFourText="Behandlingen efterlader ofte en følelse af afslapning, friskhed og fornyet kontakt til dig selv."
/>

<TreatmentInfo
  title="Hvad er japansk lifting?"
  textOne="Når du vælger japansk lifting, skaber vi et dybt afspændende rum for kroppen og nervesystemet. Behandlingen hjælper dig med at slippe spændinger, berolige dit system og lande i dig selv – hvilket ofte forstærker og forankrer den proces, vi arbejder med mentalt og følelsesmæssigt. Japansk Lifting – en oplevelseJapansk lifting er langt mere end en ansigtsbehandling. Det er en dybt afspændende oplevelse for både krop, sind og nervesystem. Behandlingen kombinerer blide, dybe massageteknikker, zoneterapi og lymfedrænage, som stimulerer blodcirkulationen, giver huden glød og løfter ansigtets naturlige udtryk – samtidig med at kroppen falder til ro."
  textTwo="Mange oplever en følelse af:	indre stilhed, klarhed i hovedet, dyb afspænding, fornyet energiJapansk lifting støtter din krop i at slippe spændinger og stress – og giver dig et rum, hvor du bare må være. Et åndehul, hvor dit system får lov til at nulstille sig. Det er selvomsorg på et dybt plan. Japansk lifting- Et naturligt ansigtsløft der indeholder peeling, hovedbundsmassage, ansigtszoneterapi, lifting ansigts massage, fugtmaske, let fodzoneterapi og øjen massage. Alt med de bedste produkter. En behandling tager 75 min. og koster kr.825,-"
/>

<IndexCta />



</Layout>