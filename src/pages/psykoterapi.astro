---
import Layout from '../layouts/Layout.astro';

import TreatmentHero from '../components/TreatmentHero.astro';
import TreatmentWork from '../components/TreatmentWork.astro';
import TreatmentProcess from '../components/TreatmentProcess.astro';
import TreatmentInfo from '../components/TreatmentInfo.astro';

import IndexCta from '../components/IndexCta.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout>

<TreatmentHero
  title="Psykoterapi"
  subtitle="Samtaleterapi med fokus på krop, sind og nervesystem"
  text="Her står tekst omkring psykoterapi."
  image="/images/psykoterapi.webp"
/>

<TreatmentWork

  itemOne="Stress & Nervesystem"
  itemTwo="Selvværd & Selvtillid"
  itemThree="Overgangsfaser"
  itemFour="Krop & Forbindelse"
  itemFive="Tankemønstre & Indre ro"
  itemSix="Healing & Udvikling"

  textOne="Skab mere ro i kroppen og balance i nervesystemet."
  textTwo="Styrk forbindelsen til dig selv, dine behov og dine grænser."
  textThree="Få støtte i perioder med forandring, udvikling og nye begyndelser."
  textFour="Skab en dybere kontakt til kroppen og det, du mærker."
  textFive="Skab mere klarhed, nærvær og ro i hverdagen."
  textSix="Støtte til personlig udvikling, balance og indre forankring."
/>

<TreatmentProcess
  title="Sådan foregår det"
  image="/images/bog.png"

   stepOneTitle="Vi starter i et roligt tempo"
  stepOneText="Du bliver mødt i trygge omgivelser med plads til at lande."

  stepTwoTitle="Behandlingen tager udgangspunkt i dig"
  stepTwoText="Fokus er på dine behov, dit tempo og det, du kommer med."

  stepThreeTitle="Kroppen får mulighed for at give slip"
  stepThreeText="Mange oplever en følelse af afspænding, lethed og indre stilhed."

  stepFourTitle="Du går herfra med mere overskud"
  stepFourText="Ofte med en følelse af klarhed, grounding og ny energi."
/>

<TreatmentInfo
  title="Hvad er psykoterapi?"
  textOne="Her står første tekst."
  textTwo="Her står anden tekst."
/>

<IndexCta />

<Testimonials />

</Layout>