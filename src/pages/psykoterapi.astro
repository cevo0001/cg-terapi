---
import Layout from '../layouts/Layout.astro';

import TreatmentHero from '../components/TreatmentHero.astro';
import TreatmentWork from '../components/TreatmentWork.astro';
import TreatmentProcess from '../components/TreatmentProcess.astro';
import TreatmentInfo from '../components/TreatmentInfo.astro';

import IndexCta from '../components/IndexCta.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout>

<TreatmentHero
  title="Psykoterapi"
  subtitle="Samtaleterapi med fokus på krop, sind og nervesystem."
  text="Her står tekst omkring psykoterapi."
  image="/images/psykoterapi.webp"
/>

<TreatmentWork

  itemOne="Stress & Nervesystem"
  itemTwo="Selvværd & Selvtillid"
  itemThree="Overgangsfaser"
  itemFour="Krop & Forbindelse"
  itemFive="Tankemønstre & Indre ro"
  itemSix="Healing & Udvikling"

  textOne="Skab mere ro i kroppen og balance i nervesystemet."
  textTwo="Styrk forbindelsen til dig selv, dine behov og dine grænser."
  textThree="Få støtte i perioder med forandring, udvikling og nye begyndelser."
  textFour="Skab en dybere kontakt til kroppen og det, du mærker."
  textFive="Skab mere klarhed, nærvær og ro i hverdagen."
  textSix="Støtte til personlig udvikling, balance og indre forankring."
/>

<TreatmentProcess
  title="Sådan foregår det"
  image="/images/bog.png"

   stepOneTitle="Vi starter i et roligt tempo"
  stepOneText="Du bliver mødt i trygge omgivelser med plads til at lande."

  stepTwoTitle="Behandlingen tager udgangspunkt i dig"
  stepTwoText="Fokus er på dine behov, dit tempo og det, du kommer med."

  stepThreeTitle="Kroppen får mulighed for at give slip"
  stepThreeText="Mange oplever en følelse af afspænding, lethed og indre stilhed."

  stepFourTitle="Du går herfra med mere overskud"
  stepFourText="Ofte med en følelse af klarhed, grounding og ny energi."
/>

<TreatmentInfo
  title="Hvad er psykoterapi?"
  textOne="I mit terapeutiske arbejde møder jeg dig med nærvær, nysgerrighed og respekt for din unikke historie. Jeg arbejder ud fra et eksistentielt og oplevelsesorienteret menneskesyn, med særligt fokus på kontakt – både den indre kontakt til dig selv og den ydre kontakt til dine relationer.Jeg er optaget af at undersøge, hvad der spænder i dig. Hvor du måske har lært at tilpasse dig, undvige, rationalisere eller dulme. Og hvordan vi sammen kan skabe et rum, hvor du kan være i det, der er – uden at skulle fixe, præstere eller forklare.Mit arbejde tager udgangspunkt i Gestaltterapiens og de humanistiske principper med vægt på:	Her og nu-oplevelser,	Kontaktforstyrrelser og overlevelsesstrategier,	At få øje på og forløse gamle mønstre,	At skabe frihed til at være den, du i virkeligheden er."
  textTwo="Hvem kommer typisk hos mig? Jeg arbejder med mennesker der	føler sig fanget i gamle mønstre og gentagelser,	har svært ved at mærke deres grænser og behov, kæmper med lavt selvværd og indre kritik, længes efter ægte, tryg og nærværende kontakt,	har været i usunde relationer og ønsker at finde hjem i sig selv,	ønsker personlig udvikling og dybere selvforståelseMåske du genkender følelsen af, at du giver mere end du har, at du tvivler på din egen virkelighed, eller at du skammer dig over at fylde for meget eller for lidt. Måske du længes efter samhørighed, men glemmer dig selv i forsøget på at opnå den. Du er ikke alene. pris: Kr. 750,- for 50 minutter. Det er muligt at lave onlie-sessioner."
/>

<IndexCta />


</Layout>