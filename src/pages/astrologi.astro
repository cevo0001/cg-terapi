---
import Layout from '../layouts/Layout.astro';

import TreatmentHero from '../components/TreatmentHero.astro';
import TreatmentWork from '../components/TreatmentWork.astro';
import TreatmentProcess from '../components/TreatmentProcess.astro';
import TreatmentInfo from '../components/TreatmentInfo.astro';

import IndexCta from '../components/IndexCta.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout>

<TreatmentHero
  title="Astrologi"
  subtitle="Få indsigt i dine mønstre, relationer og personlige udvikling. Online muligt."
  text="Astrologi kan skabe større forståelse for dig selv, dine relationer og de livstemaer, du bevæger dig i."
  image="/images/astrologihero.png"
/>

<TreatmentWork

  itemOne="Livstemaer & Retning"
  itemTwo="Relationer & Dynamikker"
  itemThree="Potentialer & Styrker"
  itemFour="Refleksion & Bevidsthed"
  itemFive="Mønstre & Udvikling"
  itemSix="Klarhed & Forbindelse"

  textOne="Få indsigt i de mønstre og temaer, der præger dit liv."
  textTwo="Skab større forståelse for dig selv og dine relationer."
  textThree="Bliv klogere på dine naturlige ressourcer og muligheder."
  textFour="Et rum til fordybelse, selvindsigt og nye perspektiver."
  textFive="Udforsk det, der gentager sig - og det, der ønsker at udvikle sig."
  textSix="Mange oplever større klarhed og kontakt til sig selv efter sessionen."
/>

<TreatmentProcess
  title="Sådan foregår det"
  image="/images/astrolog.png"

  stepOneTitle="Vi tager udgangspunkt i dit horoskop"
stepOneText="Sessionen starter med dit fødselshoroskop og de temaer, du ønsker at undersøge."

stepTwoTitle="Vi ser på dine mønstre"
stepTwoText="Sammen udforsker vi relationer, livstemaer, styrker og de steder, hvor noget gentager sig."

stepThreeTitle="Astrologien bruges som spejl"
stepThreeText="Horoskopet bliver et refleksionsværktøj, der kan skabe nye perspektiver og større selvforståelse."

stepFourTitle="Du går herfra med indsigt"
stepFourText="Målet er, at du får mere klarhed, retning og forbindelse til det, der føles sandt for dig."
/>

<TreatmentInfo
  title="Hvad kan astrologi bruges til?"
  textOne="Astrologi er for mig et dybt menneskeligt og psykologisk værktøj til selvindsigt, forståelse og retning. Dit fødselshoroskop er som et kort over de energier, potentialer og temaer, du er født med. Det kan give indsigt i dine styrker, relationer, længsler, udfordringer og livstemaer – og hjælpe dig til at forstå dig selv på et dybere plan. Jeg er uddannet astrolog og tilbyder astrologiske læsninger med udgangspunkt i dine fødsels data. En session hos mig er ikke spådom, men en nærværende samtale, hvor vi sammen undersøger de mønstre, muligheder og udviklingsområder, der viser sig i dit horoskop."
  textTwo="Mange oplever astrologien som en måde at finde hjem til sig selv på. At få sprog for noget, de længe har mærket indeni. Du er velkommen med forskellige temaer eller fokusområder – fx: kærlighed og relationer, arbejdsliv og retning,  livskriser og forandringer, selvværd og identitet eller personlig udvikling. For at jeg kan udarbejde dit horoskop, skal jeg bruge: fødselsdato, præcist fødselstidspunkt og fødested. Kender du ikke dit fødselstidspunkt, kan det ofte findes via: Rigsarkivet (For personer født før 1989) Er du født efter 1989, kan tidspunktet ofte findes via CPR-oplysninger på Borger.dk. pris: 60-90 min kr 1111,-. Det er muligt at lave online-sessioner."
/>

<IndexCta />



</Layout>