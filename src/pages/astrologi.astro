---
import Layout from '../layouts/Layout.astro';

import TreatmentHero from '../components/TreatmentHero.astro';
import TreatmentWork from '../components/TreatmentWork.astro';
import TreatmentProcess from '../components/TreatmentProcess.astro';
import TreatmentInfo from '../components/TreatmentInfo.astro';

import IndexCta from '../components/IndexCta.astro';
import Testimonials from '../components/Testimonials.astro';
---

<Layout>

<TreatmentHero
  title="Astrologi"
  subtitle="Få indsigt i dine mønstre, relationer og personlige udvikling"
  text="Astrologi kan skabe større forståelse for dig selv, dine relationer og de livstemaer, du bevæger dig i."
  image="/images/astrologi.webp"
/>

<TreatmentWork

  itemOne="Personlig udvikling"
  itemTwo="Relationer"
  itemThree="Livsretning"
  itemFour="Mønstre"
  itemFive="Selvforståelse"
  itemSix="Indre balance"

  textOne="Få indsigt i dine styrker og udviklingsområder."
  textTwo="Forstå dynamikker i dine relationer."
  textThree="Skab klarhed omkring retning og valg."
  textFour="Bliv bevidst om gentagende mønstre."
  textFive="Få større forståelse for dig selv."
  textSix="Skab mere ro og balance i hverdagen."
/>

<TreatmentProcess
  title="Sådan foregår det"
  image="/images/astrologi-room.webp"
/>

<TreatmentInfo
  title="Hvad kan astrologi bruges til?"
  textOne="Astrologi kan skabe indsigt i personlighed, relationer og livstemaer og bruges som et refleksionsværktøj til større selvforståelse."
  textTwo="Sessionerne tager udgangspunkt i dit personlige horoskop og tilpasses dine spørgsmål, behov og udviklingsproces."
/>

<IndexCta />

<Testimonials />

</Layout>