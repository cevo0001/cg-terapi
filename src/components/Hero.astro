---
import Button from './Button.astro';
---

<section class="hero">

  <div class="hero-text">

    <h1>Charlotte Grøngaard</h1>

    <h2>
      Et trygt rum til kvinder i
      overgang & udvikling
    </h2>

    <p>
      Holistisk terapi der skaber balance i
      krop, sind og nervesystem.
    </p>

    <div class="button-row">

      <Button
        text="Book tid"
        link="/kontakt"
        className="btn"
      />

      <Button
        text="Mine behandlinger"
        link="/behandlinger"
        className="btn-secondary"
      />

    </div>

  </div>

</section>

<style>
.hero {
  min-height: 470px;
  padding: 70px 24px;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  background-image:
    linear-gradient(
      rgba(255, 248, 233, 0),
      rgba(255, 248, 233, 0.243)
    ),
    url('/images/hero.webp');

  background-size: cover;
  background-position: center;

}

.hero-text {
  max-width: 310px;
}

.hero h1 {
   font-size: 36px;
  line-height: 1.15;
  margin-bottom: 18px;
}

.hero h2 {
  font-size: 25px;
  line-height: 1.3;
  margin-bottom: 18px;
}

.hero p {
  font-size: 17px;
  line-height: 1.3;
  margin-bottom: 30px;
}

.button-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30px;
  margin-bottom: -25px;
}

/* DESKTOP */
@media (min-width: 900px) {
  .hero {
    min-height: 430px;
    padding: 70px 70px 70px 150px;

    justify-content: flex-start;
    text-align: left;

    background-position: center;
  }

  .hero-text {
    max-width: 490px;
  }

  .hero h1 {
    display: block;
    font-size: 56px;
    margin-bottom: 20px;
  }

  .hero h2 {
    font-size: 35px;
    line-height: 1.2;
    margin-right: 80px;
    margin-bottom: 10px;
  }

  .hero p {
    font-size: 19px;
    line-height: 1.5;
    font-style: italic;
    margin-bottom: 60px;

    color: var(--black);
  }

  .button-row {
    flex-direction: row;
    justify-content: flex-start;
    gap: 33px;
    margin-bottom: -40px;
  }
}
</style>