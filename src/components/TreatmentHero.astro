---
const {
  title,
  subtitle,
  text,
  image
} = Astro.props;
---

<section class="treatment-hero">

  <div class="hero-text">

    <h1>{title}</h1>

    <h2>{subtitle}</h2>

    

    <a href="/kontakt" class="btn">
      Book din tid
    </a>

  </div>

  <img src={image} alt="" />

</section>

<style>

  .treatment-hero {
    padding: 30px 20px;
    background: var(--beige);
    border-bottom: 1px solid var(--brown);

    display: grid;
    gap: 24px;

    align-items: center;
  }

  .hero-text {
    max-width: 420px;
  }

  .hero-text h1 {
    font-size: 34px;
    line-height: 1.05;
    margin-bottom: 12px;
  }

  .hero-text h2 {
    font-size: 22px;
    line-height: 1.3;
    margin-bottom: 20px;
    font-weight: 300;
  }

  .hero-text .btn {
    padding: 10px 22px;
    font-size: 15px;
    margin-top: 10px;
  }

  .treatment-hero img {
    width: 90%;
    height: 230px;
    border-radius: 0 0 55px 0;
    margin-left: 50px;
    object-fit: cover;
  }

  @media (min-width: 900px) {

    .treatment-hero {
      grid-template-columns: 0.9fr 1.1fr;

      padding: 40px 90px;

      gap: 50px;
    }

    .hero-text {
      max-width: 460px;
    }

    .hero-text h1 {
      font-size: 42px;
      margin-bottom: 14px;
    }

    .hero-text h2 {
      font-size: 28px;
      margin-bottom: 24px;
    }

    .treatment-hero img {
      height: 320px;

      border-radius: 0 0 70px 0;
    }

  }

</style>