---
const {
  title,
  image,
  stepOneTitle,
  stepOneText,
  stepTwoTitle,
  stepTwoText,
  stepThreeTitle,
  stepThreeText,
  stepFourTitle,
  stepFourText
} = Astro.props;
---

<section class="process-section">

  <img src={image} alt="" />

  <div>

    <h2>{title}</h2>

    <ol>

      <li>
  <strong>{stepOneTitle}</strong><br>
  {stepOneText}
</li>

<li>
  <strong>{stepTwoTitle}</strong><br>
  {stepTwoText}
</li>

<li>
  <strong>{stepThreeTitle}</strong><br>
  {stepThreeText}
</li>

<li>
  <strong>{stepFourTitle}</strong><br>
  {stepFourText}
</li>
    </ol>

  </div>

</section>

<style>

  .process-section {
    padding: 45px 24px;

    background: var(--beige);

    border-bottom: 1px solid var(--brown);

    display: grid;
    gap: 32px;
  }

  .process-section img {
    width: 100%;
  }

  .process-section h2 {
    font-size: 30px;

    margin-bottom: 24px;
  }

  ol {
    display: grid;

    gap: 18px;

    list-style-position: inside;
  }

  li {
    line-height: 1.6;
  }

  @media (min-width: 900px) {

    .process-section {
      grid-template-columns: 1fr 1.2fr;

      align-items: center;

      padding: 70px 100px;

      gap: 80px;
    }

  }

</style>