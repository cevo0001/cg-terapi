---
const {
  itemOne,
  itemTwo,
  itemThree,
  itemFour,
  itemFive,
  itemSix,

  textOne,
  textTwo,
  textThree,
  textFour,
  textFive,
  textSix
} = Astro.props;
---

<section class="work-section">

  <h2>Hvad kan vi arbejde med?</h2>

  <div class="work-grid">

    <div class="work-item">

      <img src="/images/icon.svg" alt="" />

      <h3>{itemOne}</h3>

      <p>{textOne}</p>

    </div>

    <div class="work-item">

      <img src="/images/icon.svg" alt="" />

      <h3>
        {itemTwo}
      </h3>

      <p>
        {textTwo}
      </p>

    </div>

    <div class="work-item">

      <img src="/images/icon.svg" alt="" />

      
        <h3>{itemThree}</h3>
      

      <p>
        {textThree}
      </p>

    </div>

    <div class="work-item">

      <img src="/images/icon.svg" alt="" />

      <h3>{itemFour}</h3>

      <p>
        {textFour}
      </p>

    </div>

    <div class="work-item">

      <img src="/images/icon.svg" alt="" />

      <h3>{itemFive}</h3>

      <p>
        {textFive}
      </p>

    </div>

    <div class="work-item">

      <img src="/images/icon.svg" alt="" />

      <h3>{itemSix}</h3>

      <p>
        {textSix}
      </p>

    </div>

  </div>

</section>

<style>

  .work-section {
    padding: 45px 22px;

    background: var(--cream);

    border-bottom: 1px solid var(--brown);

    text-align: center;
  }

  .work-section h2 {
    font-size: 28px;

    margin-bottom: 35px;
  }

  .work-grid {
    display: grid;

    gap: 26px;
  }

  .work-item {
    max-width: 260px;

    margin: 0 auto;
  }

  .work-item img {
    width: 58px;

    margin: 0 auto 14px;
  }

  .work-item h3 {
    font-size: 18px;

    margin-bottom: 12px;
  }

  .work-item p {
    font-size: 14px;

    line-height: 1.5;
  }

  @media (min-width: 900px) {

    .work-section {
      padding: 45px 60px 65px;
    }

    .work-grid {
      grid-template-columns: repeat(6, 1fr);

      max-width: 1250px;

      margin: 0 auto;
    }

    .work-item {
      padding: 0 25px;

      border-right: 1px solid rgba(87, 65, 56, 0.35);
    }

    .work-item:last-child {
      border-right: none;
    }

  }

</style>