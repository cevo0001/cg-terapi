---
const {

  itemOne,
  itemTwo,
  itemThree,
  itemFour,
  itemFive,
  itemSix,

  textOne,
  textTwo,
  textThree,
  textFour,
  textFive,
  textSix
} = Astro.props;
---

<section class="work-section">

  <h2>Hvad kan vi arbejde med?</h2>

  <div class="work-grid">

    <div class="work-item">

      <img src="/images/ikon1.png" alt="" />

      <h3>{itemOne}</h3>

      <p>{textOne}</p>

    </div>

    <div class="work-item">

      <img src="/images/ikon2.png" alt="" />

      <h3>
        {itemTwo}
      </h3>

      <p>
        {textTwo}
      </p>

    </div>

    <div class="work-item">

      <img src="/images/ikon3.png" alt="" />

      
        <h3>{itemThree}</h3>
      

      <p>
        {textThree}
      </p>

    </div>

    <div class="work-item">

      <img src="/images/ikon4.png" alt="" />

      <h3>{itemFour}</h3>

      <p>
        {textFour}
      </p>

    </div>

    <div class="work-item">

      <img src="/images/ikon7.png" alt="" />

      <h3>{itemFive}</h3>

      <p>
        {textFive}
      </p>

    </div>

    <div class="work-item">

      <img src="/images/ikon8.png" alt="" />

      <h3>{itemSix}</h3>

      <p>
        {textSix}
      </p>

    </div>

  </div>

</section>

<style>

  .work-section {
    padding: 34px 20px 40px;
    background: var(--cream);
    border-bottom: 1px solid var(--brown);
    text-align: center;
  }

  .work-section h2 {
    font-size: 28px;
    margin-bottom: 28px;
    line-height: 1.1;
  }

  .work-grid {
    display: grid;
    gap: 24px;
  }

  .work-item {
    max-width: 220px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .work-item img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    margin-bottom: 18px;
  }

  .work-item h3 {
    font-size: 16px;
    margin-bottom: 10px;
    min-height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;
    line-height: 1.3;
  }

  .work-item p {
    font-size: 14px;
    line-height: 1.5;
  }

  @media (min-width: 900px) {

    .work-section {
      padding: 40px 45px 48px;
    }

    .work-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 0;
      max-width: 1180px;
      margin: 0 auto;
    }

    .work-item {
      padding: 0 18px;
      border-right: 1px solid rgba(87, 65, 56, 0.22);
      max-width: none;
    }

    .work-item:last-child {
      border-right: none;
    }

    .work-item img {
      width: 30px;
      height: 30px;
    }

    .work-item h3 {
      font-size: 15px;
font-weight: 500;
      min-height: 48px;
    }

    .work-item p {
      font-size: 14px;
    }

  }

</style>