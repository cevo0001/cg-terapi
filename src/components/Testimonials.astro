<section class="testimonials-section">

  <h2>Klientoplevelser</h2>

  <div class="line"></div>

  <div class="slider" id="testimonialSlider">

    <article class="testimonial-card">

      <p class="quote">
        “Jeg følte mig mødt med ro, nærvær og tryghed gennem hele behandlingen.”
      </p>

      <p class="name">
        — Klient
      </p>

    </article>

    <article class="testimonial-card">

      <p class="quote">
        “Det gav mig en følelse af mere balance og kontakt til mig selv.”
      </p>

      <p class="name">
        — Klient
      </p>

    </article>

    <article class="testimonial-card">

      <p class="quote">
        “Et varmt og trygt rum, hvor jeg kunne lande og give slip.”
      </p>

      <p class="name">
        — Klient
      </p>

    </article>

  </div>

  <div class="dots">

    <button class="dot active" data-slide="0"></button>

    <button class="dot" data-slide="1"></button>

    <button class="dot" data-slide="2"></button>

  </div>

</section>

<script is:inline>

  const slider = document.querySelector("#testimonialSlider");

  const dots = document.querySelectorAll(".dot");

  let currentSlide = 0;

  function goToSlide(slideNumber) {

    currentSlide = slideNumber;

    slider.scrollTo({

      left: slider.clientWidth * currentSlide,

      behavior: "smooth",

    });

    dots.forEach((dot) => {

      dot.classList.remove("active");

    });

    dots[currentSlide].classList.add("active");

  }

  dots.forEach((dot) => {

    dot.addEventListener("click", () => {

      goToSlide(Number(dot.dataset.slide));

    });

  });

  setInterval(() => {

    currentSlide++;

    if (currentSlide >= dots.length) {

      currentSlide = 0;

    }

    goToSlide(currentSlide);

  }, 8000);

</script>

<style>

  .testimonials-section {

    padding: 28px 10px;

    background: var(--light-green);

    text-align: center;

    overflow: hidden;
  }

  .testimonials-section h2 {

    font-size: 24px;

    margin-bottom: 6px;
  }

  .line {

    width: 110px;

    height: 0.5px;

    background: var(--brown);

    margin: 0 auto 18px;
  }

  .slider {

    display: flex;

    overflow: hidden;

    width: 100%;

    scroll-behavior: smooth;
  }

  .testimonial-card {

    flex: 0 0 100%;

    padding: 0 10px;
  }

  .quote {

    max-width: 560px;

    margin: 0 auto 6px;

    font-size: 15px;

    line-height: 1.5;

    font-style: italic;
  }

  .name {

    font-size: 14px;
  }

  .dots {

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 8px;

    margin-top: 14px;

    width: 100%;
  }

  .dot {

    width: 10px;

    height: 10px;

    border-radius: 50%;

    border: none;

    background: var(--cream);

    opacity: 0.7;

    cursor: pointer;

    transition: 0.3s;
  }

  .dot.active {

    background: var(--dark-green);

    opacity: 1;
  }

  @media (min-width: 900px) {

    .testimonials-section {

      padding: 36px 20px;
    }

    .quote {

      font-size: 16px;

      max-width: 620px;
    }

  }

</style>