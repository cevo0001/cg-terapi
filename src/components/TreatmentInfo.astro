---
const {
  title,
  textOne,
  textTwo
} = Astro.props;
---

<section class="info-section">

  <h2>{title}</h2>

  <p>{textOne}</p>

  <p>{textTwo}</p>

</section>

<style>

  .info-section {
    padding: 50px 24px;

    background: var(--sand);

    border-bottom: 1px solid var(--brown);

    display: grid;
    gap: 24px;
  }

  .info-section h2 {
    font-size: 30px;

    margin-bottom: 10px;
  }

  .info-section p {
    line-height: 1.7;

    font-size: 16px;
  }

  @media (min-width: 900px) {

    .info-section {
      grid-template-columns: 1fr 1fr;

      padding: 70px 110px;
    }

    .info-section h2 {
      grid-column: 1 / -1;

      text-align: center;
    }

  }

</style>