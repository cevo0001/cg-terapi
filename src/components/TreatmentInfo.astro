---
const {
  title,
  textOne,
  textTwo
} = Astro.props;
---

<section class="info-section">

  <h2>{title}</h2>

  <div class="info-grid">

    <p>{textOne}</p>

    <p>{textTwo}</p>

  </div>

</section>

<style>

  .info-section {

    padding: 60px 24px;

    background: var(--sand);

    border-bottom: 1px solid var(--brown);

    text-align: center;
  }

  .info-section h2 {

    font-size: 32px;

    margin-bottom: 40px;
  }

  .info-grid {

    display: grid;

    gap: 30px;

    max-width: 1000px;

    margin: 0 auto;
  }

  .info-grid p {

    line-height: 1.9;

    font-size: 16px;

    text-align: left;
  }

  @media (min-width: 900px) {

    .info-section {

      padding: 80px 100px;
    }

    .info-grid {

      grid-template-columns: 1fr 1fr;

      gap: 60px;
    }

    .info-section h2 {

      font-size: 38px;
    }

  }

</style>