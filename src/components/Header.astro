---
import Button from './Button.astro';
---

<header class="header">
  <a href="/">
    <img src="/images/logo.svg" alt="Logo" class="logo" />
  </a>

  <button class="burger" id="burger" aria-label="Åbn menu">
    ☰
  </button>

  <nav class="nav" id="nav">
    <a href="/#behandlinger">Behandlinger</a>
    <a href="/om-mig">Om mig</a>
    <a href="/priser">Priser</a>
    <a href="/kontakt">Kontakt</a>

    <Button text="Book tid" link="/kontakt" className="btn" />
  </nav>
</header>

<script is:inline>

  const burger = document.querySelector('#burger');
  const nav = document.querySelector('#nav');

  if (burger && nav) {

    burger.addEventListener('click', () => {

      nav.classList.toggle('open');

    });

  }

</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 1000;

    height: 78px;
    padding: 0 22px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    background: var(--cream);
    border-bottom: 1px solid var(--brown);
  }

  .logo {
    width: 62px;
  }

  .burger {
    background: none;
    border: none;
    color: var(--brown);

    font-size: 32px;
    line-height: 1;

    cursor: pointer;
  }

 .nav {
  position: absolute;
  top: 78px;
  left: 0;

  width: 100%;

  display: grid;
  gap: 24px;

  padding: 35px 24px;

  background: var(--cream);

  text-align: center;

  border-bottom: 1px solid var(--brown);

  opacity: 0;
  visibility: hidden;

  transform: translateY(-20px);

  transition:
    opacity 0.4s ease,
    transform 0.4s ease;

}

.nav.open {
  opacity: 1;

  visibility: visible;

  transform: translateY(0);
}

  .nav a {
    text-decoration: none;
    color: var(--brown);

    font-size: 20px;
    font-family: 'Source Sans 3', sans-serif;
    font-weight: 300;
  }

  .nav .btn {
    margin: 10px auto 0;
  }

  @media (min-width: 900px) {
    .header {
      height: 90px;
      padding: 0 50px;
    }

    .logo {
      width: 75px;
    }

    .burger {
      display: none;
    }

   .nav,
.nav.open {
  position: static;

  width: auto;

  display: flex;
  align-items: center;
  gap: 85px;

  padding: 0;

  background: transparent;

  border-bottom: none;

  opacity: 1;
  visibility: visible;

  transform: translateY(0);
}

    .nav a {
      font-size: 18px;
    }

    .nav .btn {
      margin: 0;
    }
  }
</style>