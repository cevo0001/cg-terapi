<form method="POST" id="form" class="contact-form">
  <input
    type="hidden"
    name="access_key"
    value="45c4ed63-742b-47d5-9f40-42338b4ed51c"
  />

  <h2>Send mig en besked for booking af tid</h2>

  <label>
    Fulde navn
    <input type="text" name="name" required />
  </label>


   <label>
    Mail
    <input
     type="email"
      name="email"
      required
      pattern=".+@.+\..+"
    />
    </label>


  <label>
    Behandling
    <select name="treatment" required>
      <option value="">Vælg behandling</option>
      <option value="Psykoterapi">Psykoterapi</option>
      <option value="Japansk lifting">Japansk lifting</option>
      <option value="Spørgsmål">Jeg har et spørgsmål</option>
    </select>
  </label>

  <label class="message-label">
    Besked
    <textarea name="message" id="message" maxlength="200" required></textarea>
    <span id="char-count">0 / 200</span>
  </label>

  <button type="submit">Send besked</button>

  <p id="result"></p>
</form>

<script is:inline>
  const form = document.getElementById("form");
  const result = document.getElementById("result");
  const message = document.getElementById("message");
  const charCount = document.getElementById("char-count");

  if (message && charCount) {
    message.addEventListener("input", () => {
      charCount.textContent = `${message.value.length} / 200`;
    });
  }

  if (form && result) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const formData = new FormData(form);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      result.innerHTML = "Sender besked...";

      fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: json,
      })
        .then(async (response) => {
          const data = await response.json();

          if (response.status === 200) {
            result.innerHTML = "Tak! Din besked er sendt.";
            form.reset();
            charCount.textContent = "0 / 200";
          } else {
            result.innerHTML = data.message;
          }
        })
        .catch(() => {
          result.innerHTML = "Noget gik galt. Prøv igen senere.";
        });
    });
  }
</script>

<style>
  .contact-form {
    padding: 24px 18px;
    border: 1px solid var(--brown);
    border-radius: 16px;
    background: var(--beige);

    display: grid;
    gap: 14px;

    max-width: 520px;
    margin: 0 auto;
  }

  .contact-form h2 {
    font-size: 24px;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  label {
    display: grid;
    gap: 6px;
    font-size: 15px;
    font-style: italic;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 10px 12px;

    border: 1px solid var(--brown);
    border-radius: 999px;

    background: var(--white);

    font-family: 'Source Sans 3', sans-serif;
    font-size: 15px;
  }


  textarea {
    min-height: 110px;
    border-radius: 16px;
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border: 2px solid var(--dark-green);
  }

  .message-label {
    position: relative;
  }

  #char-count {
    justify-self: end;
    margin-top: 2px;
    font-size: 12px;
    opacity: 0.7;
  }

  button {
    justify-self: center;
    margin-top: 4px;

    padding: 10px 24px;

    border-radius: 999px;
    border: 1px solid var(--brown);

    background: var(--dark-green);
    color: var(--white);

    font-family: 'Source Sans 3', sans-serif;
    font-size: 15px;

    cursor: pointer;

    transition: 0.3s;
  }

  button:hover {
    background: var(--brown);
  }

  #result {
    text-align: center;
    font-size: 14px;
  }

  @media (min-width: 900px) {

    .contact-form {
      padding: 30px 28px;
      max-width: 560px;
    }

    .contact-form h2 {
      font-size: 28px;
    }

  }
</style>